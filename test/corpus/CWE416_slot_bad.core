// EXPECT: use_after_free
// ENTRY: f
core.func @f(i32) -> i32 {
^entry(%x: i32):
  %n = core.const 8 : i64
  %p = core.heap_alloc %n {fail=never} : ptr
  %v0 = core.const 5 : i32
  core.store %v0, %p
  %slot = core.alloca {size=8, align=8} : ptr
  core.store %p, %slot
  core.free %p
  %q = core.load %slot : ptr
  core.check.null %q
  core.check.uaf %q
  %v = core.load %q : i32
  core.return %x
}
