// EXPECT: none
// ENTRY: f
// LIBC
core.declare @malloc(i64) -> ptr
core.declare @free(ptr) -> void
core.declare @calloc(i64, i64) -> ptr
core.declare @memcpy(ptr, ptr, i64) -> ptr
core.declare @memset(ptr, i32, i64) -> ptr
core.func @f(i32) -> i32 {
^entry(%x: i32):
  %n = core.const 4 : i64
  %p = core.call @calloc(%n, %n) : ptr
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^nomem, ^have
^nomem:
  core.return %x
^have:
  core.check.uninit %p {w=4}
  %v = core.load %p : i32
  core.return %v
}
