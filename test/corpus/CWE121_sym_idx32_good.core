// EXPECT: none
// ENTRY: f
core.func @f(i32) -> i32 {
^entry(%x: i32):
  %buf = core.alloca {size=32} : ptr
  %i = core.zext %x : i64
  %lim = core.const 32 : i64
  %in = core.icmp ult %i, %lim : bool
  core.cond_br %in, ^go, ^out
^out:
  %m = core.const -1 : i32
  core.return %m
^go:
  %q = core.ptr_add %buf, %i : ptr
  core.check.oob %q {w=1, access="w"}
  %b = core.const 1 : i8
  core.store %b, %q
  core.return %x
}
