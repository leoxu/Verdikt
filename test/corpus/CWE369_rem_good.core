// EXPECT: none
// ENTRY: f
core.func @f(i32) -> i32 {
^entry(%d: i32):
  %z = core.const 0 : i32
  %isz = core.icmp eq %d, %z : bool
  core.cond_br %isz, ^out, ^go
^out:
  core.return %z
^go:
  %hundred = core.const 100 : i32
  core.check.div %hundred, %d
  %r = core.srem %hundred, %d : i32
  core.return %r
}
