// end of file / error: NULL. The bytes come from __hlir_fill_file (a ModelDB `source`, see libc.yaml), so they are tainted.
core.declare @__hlir_fill_file(ptr, i64) -> void
core.func @fgets(ptr, i32, ptr) -> ptr {
^entry(%buf: ptr, %n: i32, %fp: ptr):
