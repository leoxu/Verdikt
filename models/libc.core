  core.return %pv
}

core.func @strtoull(ptr, ptr, i32) -> i64 {
^entry(%a: ptr, %b: ptr, %c: i32):
  %s = core.const 0 : i32
  %r = core.call @__hlir_strtox(%a, %b, %c, %s) : i64
  core.return %r
}
core.func @strtoul(ptr, ptr, i32) -> i64 {
^entry(%a: ptr, %b: ptr, %c: i32):
  %s = core.const 0 : i32
  %r = core.call @__hlir_strtox(%a, %b, %c, %s) : i64
  core.return %r
}
core.func @strtoll(ptr, ptr, i32) -> i64 {
^entry(%a: ptr, %b: ptr, %c: i32):
  %s = core.const 1 : i32
  %r = core.call @__hlir_strtox(%a, %b, %c, %s) : i64
  core.return %r
}
core.func @strtol(ptr, ptr, i32) -> i64 {
^entry(%a: ptr, %b: ptr, %c: i32):
  %s = core.const 1 : i32
  %r = core.call @__hlir_strtox(%a, %b, %c, %s) : i64
  core.return %r
}

// double strtod(const char *nptr, char **endptr): unlike strtol/strtoul above, there was no model for this at all, so it fell
// back to the generic opaque-external default — whose `endptr` output is an independent/arbitrary pointer, not one guaranteed
// to point back into `nptr`'s object. Real strtod's contract (like strtol's, already modelled) guarantees endptr points into
// the very same string passed in (unchanged, at nptr, when nothing was consumed), so `endptr - nptr` is always a same-object
// pointer difference — a very common idiom (cJSON's parse_number does exactly this) that the opaque default broke, reporting a
// spurious ptr_cmp_diff_obj. The float value itself isn't modelled exactly (`core` has no float type; floating point is
// IEEE-bit-pattern-only and unconstrained for non-constant operands, see core.fop) — only the pointer semantics need to be
// right here, so this scans the same superset of characters (digits, '.', 'e'/'E', '+'/'-') cJSON's own pre-filter accepts
// before calling strtod, which is a safe over-approximation of real strtod's grammar for bounds/pointer purposes.
core.func @strtod(ptr, ptr) -> i64 {
^entry(%nptr: ptr, %endp: ptr):
  core.check.null %nptr
  core.check.uaf %nptr
  %z = core.const 0 : i64
  core.br ^ws(%z)
^ws(%i: i64):
  %c = core.call @__hlir_cbyte(%nptr, %i) : i64
  %k32 = core.const 32 : i64
  %k9 = core.const 9 : i64
  %k14 = core.const 14 : i64
  %isb = core.icmp eq %c, %k32 : bool
  %ge9 = core.icmp uge %c, %k9 : bool
  %lt14 = core.icmp ult %c, %k14 : bool
  %isr = core.and %ge9, %lt14 : bool
  %issp = core.or %isb, %isr : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %issp, ^ws(%in), ^sign(%i)
^sign(%s0: i64):
  %c2 = core.call @__hlir_cbyte(%nptr, %s0) : i64
  %k45 = core.const 45 : i64
  %k43 = core.const 43 : i64
  %isneg = core.icmp eq %c2, %k45 : bool
  %isplus = core.icmp eq %c2, %k43 : bool
  %hass = core.or %isneg, %isplus : bool
  %o1 = core.const 1 : i64
  %s1 = core.add %s0, %o1 : i64
  %start = core.select %hass, %s1, %s0 : i64
  core.br ^scan(%start)
^scan(%j: i64):
  %cj = core.call @__hlir_cbyte(%nptr, %j) : i64
  %d0 = core.const 48 : i64
  %d10 = core.const 58 : i64
  %isdig1 = core.icmp uge %cj, %d0 : bool
  %isdig2 = core.icmp ult %cj, %d10 : bool
  %isdigit = core.and %isdig1, %isdig2 : bool
  %dot = core.const 46 : i64
  %isdot = core.icmp eq %cj, %dot : bool
  %eC = core.const 101 : i64
  %isE1 = core.icmp eq %cj, %eC : bool
  %EC = core.const 69 : i64
  %isE2 = core.icmp eq %cj, %EC : bool
  %ise = core.or %isE1, %isE2 : bool
  %plus = core.const 43 : i64
  %isplus2 = core.icmp eq %cj, %plus : bool
  %minus = core.const 45 : i64
  %isminus2 = core.icmp eq %cj, %minus : bool
  %ispm = core.or %isplus2, %isminus2 : bool
  %a1 = core.or %isdigit, %isdot : bool
  %a2 = core.or %a1, %ise : bool
  %isnum = core.or %a2, %ispm : bool
  %jn = core.add %j, %one : i64
  core.cond_br %isnum, ^scan(%jn), ^done(%j)
^done(%e: i64):
  %isnull = core.is_null %endp : bool
  core.cond_br %isnull, ^value, ^setend
^setend:
  core.check.uaf %endp
  core.check.oob %endp {w=8, access="w", origin="strtod endptr"}
  %nodig = core.icmp eq %e, %start : bool
  %endpos = core.select %nodig, %z, %e : i64
  %endq = core.ptr_add %nptr, %endpos : ptr
  core.store %endq, %endp {waived="checked above"}
  core.br ^value
^value:
  %r = core.nondet {name="strtod_value"} : i64
  core.return %r
}

// void *realloc(void *p, size_t n): NULL p is malloc(n); n == 0 frees (glibc: returns NULL); otherwise a new block with the old
// contents (values and taint) up to min(old, n); the old block is freed only on success. p must be a live heap pointer to its start.
core.func @realloc(ptr, i64) -> ptr {
^entry(%p: ptr, %n: i64):
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^fresh, ^have
^fresh:
  %q0 = core.heap_alloc %n {fail=nondet, name="realloc_fail"} : ptr
  core.return %q0
^have:
  %z = core.const 0 : i64
  %zero = core.icmp eq %n, %z : bool
  core.cond_br %zero, ^release, ^grow
^release:
  core.check.free %p {expect=heap, origin="realloc"}
  core.free %p
  %zi = core.const 0 : i64
  %np = core.int_to_ptr %zi : ptr
  core.return %np
^grow:
  core.check.free %p {expect=heap, origin="realloc"}
  %old = core.obj_size %p : i64
  %q = core.heap_alloc %n {fail=nondet, name="realloc_fail"} : ptr
  %isf = core.is_null %q : bool
  core.cond_br %isf, ^fail, ^copy
^fail:
  core.return %q
^copy:
  %lt = core.icmp ult %old, %n : bool
  %m = core.select %lt, %old, %n : i64
  core.memcpy %q, %p, %m
  core.free %p
  core.return %q
}

// size_t malloc_usable_size(void *p) / je_malloc_usable_size / malloc_size (macOS):
// the usable size of a heap block. glibc and jemalloc may return MORE than was requested; this model
// returns EXACTLY the allocated size, which is the conservative direction -- a larger answer would
// hand the caller slack the object may not have, and slack is where an overflow hides.
//
// Left opaque it returns an arbitrary untainted value, and an allocator that accounts with it breaks:
// Redis's sds asks for the usable size right after every allocation and asserts on it, so sdsempty()
// failed in the engine and a whole RESP scan executed ONE run with checks_queried == 0 (DESIGN.md
// Sec.22.451). NULL is defined to return 0, as in glibc.
core.func @malloc_usable_size(ptr) -> i64 {
^entry(%p: ptr):
  %n = core.is_null %p : bool
  core.cond_br %n, ^nullp, ^have
^nullp:
  %z = core.const 0 : i64
  core.return %z
^have:
  %sz = core.obj_size %p : i64
  core.return %sz
}

core.func @je_malloc_usable_size(ptr) -> i64 {
^entry(%p: ptr):
  %r = core.call @malloc_usable_size(%p) : i64
  core.return %r
}

core.func @malloc_size(ptr) -> i64 {
^entry(%p: ptr):
  %r = core.call @malloc_usable_size(%p) : i64
  core.return %r
}

// void abort(void) / exit(int) / _exit(int): the program ends, the path goes no further (an infeasible path, not a finding).
core.func @abort() -> void {
^entry:
  %z = core.const 0 : i32
  %o = core.const 1 : i32
  %f = core.icmp eq %z, %o : bool
  core.assume %f {name="abort"}
  core.return
}
core.func @exit(i32) -> void {
^entry(%c: i32):
  %z = core.const 0 : i32
  %o = core.const 1 : i32
  %f = core.icmp eq %z, %o : bool
  core.assume %f {name="exit"}
  core.return
}
core.func @_exit(i32) -> void {
^entry(%c: i32):
  %z = core.const 0 : i32
  %o = core.const 1 : i32
  %f = core.icmp eq %z, %o : bool
  core.assume %f {name="_exit"}
  core.return
}

// ---- <ctype.h> as functions (not the table-based macros): exact for the C locale, ASCII only.
core.func @isspace(i32) -> i32 {
^entry(%c: i32):
  %t1 = core.const 32 : i32
  %t2 = core.icmp eq %c, %t1 : bool
  %t3 = core.const 9 : i32
  %t4 = core.icmp sge %c, %t3 : bool
  %t5 = core.const 13 : i32
  %t6 = core.icmp sle %c, %t5 : bool
  %t7 = core.and %t4, %t6 : bool
  %t8 = core.or %t2, %t7 : bool
  %r = core.b2i %t8 : i32
  core.return %r
}
core.func @isdigit(i32) -> i32 {
^entry(%c: i32):
  %t1 = core.const 48 : i32
  %t2 = core.icmp sge %c, %t1 : bool
  %t3 = core.const 57 : i32
  %t4 = core.icmp sle %c, %t3 : bool
  %t5 = core.and %t2, %t4 : bool
  %r = core.b2i %t5 : i32
  core.return %r
}
core.func @isupper(i32) -> i32 {
^entry(%c: i32):
