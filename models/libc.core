  %t2 = core.icmp sge %c, %t1 : bool
  %t3 = core.const 90 : i32
  %t4 = core.icmp sle %c, %t3 : bool
  %t5 = core.and %t2, %t4 : bool
  %t6 = core.const 97 : i32
  %t7 = core.icmp sge %c, %t6 : bool
  %t8 = core.const 122 : i32
  %t9 = core.icmp sle %c, %t8 : bool
  %t10 = core.and %t7, %t9 : bool
  %t11 = core.or %t5, %t10 : bool
  %t12 = core.const 48 : i32
  %t13 = core.icmp sge %c, %t12 : bool
  %t14 = core.const 57 : i32
  %t15 = core.icmp sle %c, %t14 : bool
  %t16 = core.and %t13, %t15 : bool
  %t17 = core.or %t11, %t16 : bool
