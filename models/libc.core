  %last = core.ptr_add %target, %lastoff : ptr
  core.check.ptr_arith %target, %lastoff
  core.check.oob %target {w=1, access="w", origin="strncat destination start"}
  core.check.oob %last {w=1, access="w", origin="strncat destination end"}
  core.memcpy %target, %src, %copylen
