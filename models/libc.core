// C library models written in `core` (DESIGN.md §17.7 "model" calls). They run on every domain: the interpreter,
// symbolic execution and (later) the taint-selective engine all see the same bodies, with the UB checks a real libc
// would hit. Declare what you call in your own file (`core.declare @malloc(i64) -> ptr`); a model body completes it.

// void *malloc(size_t n)  — may fail (nondet), returns NULL then.
core.func @malloc(i64) -> ptr {
^entry(%n: i64):
  %p = core.heap_alloc %n {fail=nondet, name="malloc_fail"} : ptr
  core.return %p
}

// void free(void *p) — free(NULL) is a no-op; anything but a live heap pointer to its start is UB.
core.func @free(ptr) -> void {
^entry(%p: ptr):
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^done, ^do
^do:
  core.check.free %p {expect=heap, origin="free"}
  core.free %p
  core.br ^done
^done:
  core.return
}

// void *calloc(size_t n, size_t sz) — NULL when n*sz overflows, memory is zeroed.
core.func @calloc(i64, i64) -> ptr {
^entry(%n: i64, %sz: i64):
  %n128 = core.zext %n : i128
  %s128 = core.zext %sz : i128
  %w = core.mul %n128, %s128 : i128
  %t = core.trunc %w : i64
  %t128 = core.zext %t : i128
  %ovf = core.icmp ne %w, %t128 : bool
  core.cond_br %ovf, ^null, ^alloc
^null:
  %z = core.const 0 : i64
  %np = core.int_to_ptr %z : ptr
  core.return %np
^alloc:
  %p = core.heap_alloc %t {fail=nondet, name="calloc_fail"} : ptr
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^out, ^fill
^fill:
  %zero = core.const 0 : i8
  core.memset %p, %zero, %t
  core.br ^out
^out:
  core.return %p
}

// void *memcpy(void *d, const void *s, size_t n) — both ranges must be in bounds (n == 0 is fine).
core.func @memcpy(ptr, ptr, i64) -> ptr {
^entry(%d: ptr, %s: ptr, %n: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %n, %z : bool
  core.cond_br %empty, ^done, ^copy
^copy:
  core.check.null %d
  core.check.uaf %d
  core.check.null %s
  core.check.uaf %s
  %one = core.const 1 : i64
  %last = core.sub %n, %one : i64
  %dl = core.ptr_add %d, %last : ptr
  %sl = core.ptr_add %s, %last : ptr
  core.check.oob %d {w=1, access="w", origin="memcpy dst start"}
  core.check.oob %dl {w=1, access="w", origin="memcpy dst end"}
  core.check.oob %s {w=1, access="r", origin="memcpy src start"}
  core.check.oob %sl {w=1, access="r", origin="memcpy src end"}
  core.memcpy %d, %s, %n
  core.br ^done
^done:
  core.return %d
}

// void *memmove(void *d, const void *s, size_t n) — like memcpy, the ranges may overlap.
core.func @memmove(ptr, ptr, i64) -> ptr {
^entry(%d: ptr, %s: ptr, %n: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %n, %z : bool
  core.cond_br %empty, ^done, ^copy
^copy:
  core.check.null %d
  core.check.uaf %d
  core.check.null %s
  core.check.uaf %s
  %one = core.const 1 : i64
  %last = core.sub %n, %one : i64
  %dl = core.ptr_add %d, %last : ptr
  %sl = core.ptr_add %s, %last : ptr
  core.check.oob %d {w=1, access="w", origin="memmove dst start"}
  core.check.oob %dl {w=1, access="w", origin="memmove dst end"}
  core.check.oob %s {w=1, access="r", origin="memmove src start"}
  core.check.oob %sl {w=1, access="r", origin="memmove src end"}
  core.memmove %d, %s, %n
  core.br ^done
^done:
  core.return %d
}

// void *memset(void *d, int c, size_t n)
core.func @memset(ptr, i32, i64) -> ptr {
^entry(%d: ptr, %c: i32, %n: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %n, %z : bool
  core.cond_br %empty, ^done, ^fill
^fill:
  core.check.null %d
  core.check.uaf %d
  %one = core.const 1 : i64
  %last = core.sub %n, %one : i64
  %dl = core.ptr_add %d, %last : ptr
  core.check.oob %d {w=1, access="w", origin="memset start"}
  core.check.oob %dl {w=1, access="w", origin="memset end"}
  %b = core.trunc %c : i8
  core.memset %d, %b, %n
  core.br ^done
^done:
  core.return %d
}

// ---- <ctype.h>: glibc's isdigit()/isalpha()/... are macros that index the table returned by __ctype_b_loc(). Without a
// model the table is an unknown pointer (NULL or a zero object) and every use reports a bogus pointer-arithmetic error.
// The table is built on first use for the C locale: entries for characters -128..255 (index c + 128); only ASCII has flags.
// Flag bits as in glibc on little-endian: upper 0x100, lower 0x200, alpha 0x400, digit 0x800, xdigit 0x1000, space 0x2000,
// print 0x4000, graph 0x8000, blank 0x1, cntrl 0x2, punct 0x4, alnum 0x8.
core.func @__hlir_ctype_in(i64, i64, i64) -> i64 {
^entry(%ch: i64, %lo: i64, %hi: i64):
  %d = core.sub %ch, %lo : i64
  %w0 = core.sub %hi, %lo : i64
  %one = core.const 1 : i64
  %w = core.add %w0, %one : i64
  %in = core.icmp ult %d, %w : bool
  %r = core.b2i %in : i64
  core.return %r
}
core.func @__ctype_b_loc() -> ptr {
^entry:
  %flag = core.global_addr @__ctype_b_inited {size=1} : ptr
  %tab = core.global_addr @__ctype_b_table {size=768} : ptr
  %cell = core.global_addr @__ctype_b_cell {size=8} : ptr
  %cur = core.load %flag {waived="object known"} : i8
  %z8 = core.const 0 : i8
  %fresh = core.icmp eq %cur, %z8 : bool
  core.cond_br %fresh, ^init, ^done
^init:
  %one8 = core.const 1 : i8
  core.store %one8, %flag {waived="object known"}
  %zero = core.const 0 : i64
  core.br ^loop(%zero)
^loop(%i: i64):
  %n = core.const 384 : i64
  %go = core.icmp ult %i, %n : bool
  core.cond_br %go, ^body, ^fin
^body:
  %c128 = core.const 128 : i64
  %ch = core.sub %i, %c128 : i64
  %c65 = core.const 65 : i64
  %c90 = core.const 90 : i64
  %c97 = core.const 97 : i64
  %c122 = core.const 122 : i64
  %c48 = core.const 48 : i64
  %c57 = core.const 57 : i64
  %c70 = core.const 70 : i64
  %c102 = core.const 102 : i64
  %c9 = core.const 9 : i64
  %c13 = core.const 13 : i64
  %c32 = core.const 32 : i64
  %c126 = core.const 126 : i64
  %c33 = core.const 33 : i64
  %c0 = core.const 0 : i64
  %c31 = core.const 31 : i64
  %c127 = core.const 127 : i64
  %upper = core.call @__hlir_ctype_in(%ch, %c65, %c90) : i64
  %lower = core.call @__hlir_ctype_in(%ch, %c97, %c122) : i64
  %digit = core.call @__hlir_ctype_in(%ch, %c48, %c57) : i64
  %xu = core.call @__hlir_ctype_in(%ch, %c65, %c70) : i64
  %xl = core.call @__hlir_ctype_in(%ch, %c97, %c102) : i64
  %sp1 = core.call @__hlir_ctype_in(%ch, %c9, %c13) : i64
  %is32i = core.icmp eq %ch, %c32 : bool
  %is32 = core.b2i %is32i : i64
  %is9i = core.icmp eq %ch, %c9 : bool
  %is9 = core.b2i %is9i : i64
  %ct1 = core.call @__hlir_ctype_in(%ch, %c0, %c31) : i64
  %is127i = core.icmp eq %ch, %c127 : bool
  %is127 = core.b2i %is127i : i64
  %print = core.call @__hlir_ctype_in(%ch, %c32, %c126) : i64
  %graph = core.call @__hlir_ctype_in(%ch, %c33, %c126) : i64
  %alpha = core.or %upper, %lower : i64
  %alnum = core.or %alpha, %digit : i64
  %xd0 = core.or %digit, %xu : i64
  %xd = core.or %xd0, %xl : i64
  %space = core.or %sp1, %is32 : i64
  %blank = core.or %is9, %is32 : i64
  %cntrl = core.or %ct1, %is127 : i64
  %notalnum = core.not %alnum : i64
  %one = core.const 1 : i64
  %na = core.and %notalnum, %one : i64
  %punct = core.and %graph, %na : i64
  %k100 = core.const 256 : i64
  %k200 = core.const 512 : i64
  %k400 = core.const 1024 : i64
  %k800 = core.const 2048 : i64
  %k1000 = core.const 4096 : i64
  %k2000 = core.const 8192 : i64
  %k4000 = core.const 16384 : i64
  %k8000 = core.const 32768 : i64
  %k2 = core.const 2 : i64
  %k4 = core.const 4 : i64
  %k8 = core.const 8 : i64
  %f1 = core.mul %upper, %k100 : i64
  %f2 = core.mul %lower, %k200 : i64
  %f3 = core.mul %alpha, %k400 : i64
  %f4 = core.mul %digit, %k800 : i64
  %f5 = core.mul %xd, %k1000 : i64
  %f6 = core.mul %space, %k2000 : i64
  %f7 = core.mul %print, %k4000 : i64
  %f8 = core.mul %graph, %k8000 : i64
  %f9 = core.mul %cntrl, %k2 : i64
  %f10 = core.mul %punct, %k4 : i64
  %f11 = core.mul %alnum, %k8 : i64
  %s1 = core.add %f1, %f2 : i64
  %s2 = core.add %s1, %f3 : i64
  %s3 = core.add %s2, %f4 : i64
  %s4 = core.add %s3, %f5 : i64
  %s5 = core.add %s4, %f6 : i64
  %s6 = core.add %s5, %f7 : i64
  %s7 = core.add %s6, %f8 : i64
  %s8 = core.add %s7, %blank : i64
  %s9 = core.add %s8, %f9 : i64
  %s10 = core.add %s9, %f10 : i64
  %flags = core.add %s10, %f11 : i64
  %f16 = core.trunc %flags : i16
  %two = core.const 2 : i64
  %off = core.mul %i, %two : i64
  %slot = core.ptr_add %tab, %off {waived="in-bounds by construction"} : ptr
  core.store %f16, %slot {waived="in-bounds by construction"}
  %inext = core.add %i, %one : i64
  core.br ^loop(%inext)
^fin:
  %mid = core.const 256 : i64
  %base = core.ptr_add %tab, %mid {waived="in-bounds by construction"} : ptr
  core.store %base, %cell {waived="object known"}
  core.br ^done
^done:
  core.return %cell
}

// ---- more libc: ffs, strlen helper, strdup, fgets, mmap/munmap.

// int ffs(int x): 1-based index of the least significant set bit, 0 when x == 0 (so the result is in 0..32).
core.func @ffs(i32) -> i32 {
^entry(%x: i32):
  %z = core.const 0 : i32
  %zero = core.icmp eq %x, %z : bool
  core.cond_br %zero, ^none, ^loop(%z)
^loop(%i: i32):
  %one = core.const 1 : i32
  %sh = core.shl %x, %i {waived="constant in-range shift"} : i32
  %lsb = core.lshr %x, %i {waived="constant in-range shift"} : i32
  %b = core.and %lsb, %one : i32
  %set = core.icmp ne %b, %z : bool
  %n = core.add %i, %one : i32
  core.cond_br %set, ^found(%n), ^loop(%n)
^found(%r: i32):
  core.return %r
^none:
  core.return %z
}

// size_t strlen helper: every byte read is bounds checked, so an unterminated string is an oob_read.
// Bounded scan: the index of the first NUL, or `n` when there is none in the first `n` bytes -- WITHOUT reading
// byte n. strncpy and strnlen may legally be handed a buffer that is not NUL-terminated, so a model built on
// plain strlen() runs off the end of a perfectly valid object and reports an out-of-bounds read the real call
// never performs (DESIGN.md §22.385).
core.func @__hlir_strnlen(ptr, i64) -> i64 {
^entry(%s: ptr, %n: i64):
  %z = core.const 0 : i64
  %none = core.icmp eq %n, %z : bool
  core.cond_br %none, ^done(%z), ^start
^start:
  core.check.null %s
  core.check.uaf %s
  core.br ^loop(%z)
^loop(%i: i64):
  %hit = core.icmp uge %i, %n : bool
  core.cond_br %hit, ^done(%n), ^look
^look:
  %q = core.ptr_add %s, %i : ptr
  core.check.ptr_arith %s, %i
  core.check.oob %q {w=1, access="r", origin="strnlen"}
  %c = core.load %q {waived="checked above"} : i8
  %z8 = core.const 0 : i8
  %end = core.icmp eq %c, %z8 : bool
  %one = core.const 1 : i64
  %nx = core.add %i, %one : i64
  core.cond_br %end, ^done(%i), ^loop(%nx)
^done(%len: i64):
  core.return %len
}

core.func @__hlir_strlen(ptr) -> i64 {
^entry(%s: ptr):
  core.check.null %s
  core.check.uaf %s
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %q = core.ptr_add %s, %i : ptr
  core.check.ptr_arith %s, %i
  core.check.oob %q {w=1, access="r", origin="strlen"}
  %c = core.load %q {waived="checked above"} : i8
  %z8 = core.const 0 : i8
  %end = core.icmp eq %c, %z8 : bool
  %one = core.const 1 : i64
  %n = core.add %i, %one : i64
  core.cond_br %end, ^done(%i), ^loop(%n)
^done(%len: i64):
  core.return %len
}

// size_t strlen(const char *s): real source code calling strlen() directly (not through another hand-written
// model that already uses __hlir_strlen internally, like strcat/strcmp/strdup above) used to get the declarative
// YAML model instead (models/libc.yaml's `returns: { strlen: 0 }`), which the engine implements as an opaque,
// concrete-bytes-only native primitive (`cstrlen()` in lib/semantics/Memory.h) -- not real branch-structured IR.
// That has no cond_br for the concolic engine's branch-flipping exploration to discover "attacker-controlled
// content with no NUL within N bytes" (the classic non-NUL-terminated-buffer-passed-to-strlen bug shape, e.g.
// CVE-2021-3712/OpenSSL ASN1_STRING), and the symbolic engine can't evaluate it on genuinely symbolic bytes at
// all ("string length needs concrete bytes" -- the exact incomplete: note this gap produces). A `core.func` body
// here takes precedence over the YAML entry (see this file's header comment) and gives real source code calling
// strlen() the same explorable, bounds-checked loop that strcat/strcmp/strdup already get internally.
core.func @strlen(ptr) -> i64 {
^entry(%s: ptr):
  %r = core.call @__hlir_strlen(%s) : i64
  core.return %r
}

// lldiv_t lldiv(long long num, long long den) -- and it returns a STRUCT, which is why it needed a model
// rather than a whitelist entry. The frontend lowers a 16-byte struct return to an sret pointer:
//     core.declare @lldiv(ptr, i64, i64) -> void
// so an opaque @lldiv writes NEITHER field, and the caller then reads indeterminate memory. libarchive's
// __archive_ntfs_to_unix does exactly that two lines later --
//     tdiv = lldiv(value, NTFS_TICKS);
//     if (tdiv.rem < 0) { ... }
// -- which came back as a CONFIRMED uninit_read at archive_time.c:153 from BOTH the rar5 and the 7-Zip
// entries. It was the model's fault, not libarchive's (DESIGN.md Sec.22.464).
//
// The lesson the whitelist entry would have missed: "this function sizes no buffer" is the wrong test
// for whether it needs a model. What matters is whether it WRITES anything the caller reads back, and a
// struct return is a write through a pointer the caller supplied.
//
// C says the quotient is truncated toward zero, which is core.sdiv/core.srem.
core.func @lldiv(ptr, i64, i64) -> void {
^entry(%out: ptr, %num: i64, %den: i64):
  %q = core.sdiv %num, %den : i64
  %r = core.srem %num, %den : i64
  core.store %q, %out {waived="caller-supplied sret slot"}
  %eight = core.const 8 : i64
  %remp = core.ptr_add %out, %eight {waived="caller-supplied sret slot"} : ptr
  core.store %r, %remp {waived="caller-supplied sret slot"}
  core.return
}

// size_t strnlen(const char *s, size_t maxlen): the bounded form, and it had no public model at all --
// @__hlir_strnlen existed only as a helper for other hand-written bodies, so real source code calling
// strnlen() got an opaque external. That costs twice: an over-read inside the scan of s is invisible
// (an opaque call reads nothing), and the returned length is unconstrained, so every bound computed
// from it is free. libarchive's CAB reader calls it on attacker bytes and the entry failed its
// opaque_calls gate on exactly this name (DESIGN.md Sec.22.463). Same one-line delegation as @strlen
// above: the helper already walks the bytes with a per-iteration core.check.oob and stops at maxlen.
core.func @strnlen(ptr, i64) -> i64 {
^entry(%s: ptr, %n: i64):
  %r = core.call @__hlir_strnlen(%s, %n) : i64
  core.return %r
}

// char *strcpy(char *dst, const char *src): copies src including its terminating NUL to dst, which must have
// room for strlen(src)+1 bytes -- the classic overflow footgun if dst was sized for a shorter string. Same real
// core.func treatment as strcat/strncat/strdup below (and strlen above): the declarative YAML `copy:` size
// mechanism (Machine.h's model::Size::Strlen -> Memory.h's cstrlen(), opaque/concrete-bytes-only) gives neither
// the concolic engine a branch to flip nor the symbolic engine anything it can evaluate on genuinely symbolic
// bytes ("string length needs concrete bytes"). src's own readability up to its NUL is already validated by
// __hlir_strlen, so (matching strcat's pattern below) there's no separate check on the copy's source range.
core.func @strcpy(ptr, ptr) -> ptr {
^entry(%dst: ptr, %src: ptr):
  %srclen = core.call @__hlir_strlen(%src) : i64
  %one = core.const 1 : i64
  %total = core.add %srclen, %one : i64
  %lastoff = core.sub %total, %one : i64
  %last = core.ptr_add %dst, %lastoff : ptr
  core.check.ptr_arith %dst, %lastoff
  core.check.null %dst
  core.check.uaf %dst
  core.check.oob %dst {w=1, access="w", origin="strcpy destination start"}
  core.check.oob %last {w=1, access="w", origin="strcpy destination end"}
  core.memcpy %dst, %src, %total
  core.return %dst
}

// char *strcat(char *dst, const char *src): appends src (including its NUL) at dst+strlen(dst). The classic
// overflow footgun this models: dst must have room for strlen(dst)+strlen(src)+1 bytes -- if dst was
// synthesized/allocated only big enough for its initial content, appending a longer src overflows past the
// object end. src's own readability up to its NUL is already validated by __hlir_strlen, so (matching strdup's
// pattern above) there's no separate check on the copy's source range.
core.func @strcat(ptr, ptr) -> ptr {
^entry(%dst: ptr, %src: ptr):
  %dstlen = core.call @__hlir_strlen(%dst) : i64
  %srclen = core.call @__hlir_strlen(%src) : i64
  %one = core.const 1 : i64
  %total = core.add %srclen, %one : i64
  %target = core.ptr_add %dst, %dstlen : ptr
  core.check.ptr_arith %dst, %dstlen
  %lastoff = core.sub %total, %one : i64
  %last = core.ptr_add %target, %lastoff : ptr
  core.check.ptr_arith %target, %lastoff
  core.check.oob %target {w=1, access="w", origin="strcat destination start"}
  core.check.oob %last {w=1, access="w", origin="strcat destination end"}
  core.memcpy %target, %src, %total
  core.return %dst
}

// char *strncat(char *dst, const char *src, size_t n): appends at most n bytes of src at dst+strlen(dst), then
// always writes a NUL terminator after whatever was copied -- so up to n+1 bytes get written past dst's
// original content, not n (a common off-by-one source if the caller sized dst's remaining room to exactly n).
// ---- strncpy: NOT strcpy-with-a-cap. It writes exactly `n` bytes: at most strlen(src)+1 of them from src, and it
// PADS THE REST WITH ZEROS. And when strlen(src) >= n it writes NO terminator at all -- the classic footgun, which
// this model reproduces rather than papering over, so code that then reads the buffer as a C string is still caught.
//
// It had no model at all until now, which meant "assumed opaque: no effect on memory": the destination stayed
// UNINITIALISED and every later read of it was reported as a uninit_read. Found as a false positive on the c-ares
// fix tree (DESIGN.md §22.385 negative control): `strncpy(buf, src, sizeof buf)` then `if (*buf == \':\')` inside
// ares_inet_pton6, a 51-byte stack buffer the program had just filled.
core.func @strncpy(ptr, ptr, i64) -> ptr {
^entry(%dst: ptr, %src: ptr, %n: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %n, %z : bool
  core.cond_br %empty, ^done, ^write
^write:
  core.check.null %dst
  core.check.uaf %dst
  %one = core.const 1 : i64
  %lastoff = core.sub %n, %one : i64
  %last = core.ptr_add %dst, %lastoff : ptr
  core.check.ptr_arith %dst, %lastoff
  core.check.oob %dst {w=1, access="w", origin="strncpy destination start"}
  core.check.oob %last {w=1, access="w", origin="strncpy destination end"}
  // how much really comes from src: min(strlen(src), n). The +1 terminator is part of the padding below, so a
  // source at least as long as `n` contributes exactly `n` bytes and leaves the result unterminated.
  // BOUNDED: strncpy reads at most `n` bytes of src, and a src with no terminator inside them is legal -- that is
  // exactly the case where it leaves the destination unterminated. Scanning with plain strlen() here would read
  // past a valid object and invent an out-of-bounds read.
  %copylen = core.call @__hlir_strnlen(%src, %n) : i64
  core.memcpy %dst, %src, %copylen
  // pad [copylen, n) with zeros -- this is what makes the whole destination initialised, and it is the half a
  // "strcpy with a limit" model would have got wrong.
  %padlen = core.sub %n, %copylen : i64
  %nopad = core.icmp eq %padlen, %z : bool
  core.cond_br %nopad, ^done, ^pad
^pad:
  %tail = core.ptr_add %dst, %copylen : ptr
  core.check.ptr_arith %dst, %copylen
  %zb = core.const 0 : i8
  core.memset %tail, %zb, %padlen
  core.br ^done
^done:
  core.return %dst
}

core.func @strncat(ptr, ptr, i64) -> ptr {
^entry(%dst: ptr, %src: ptr, %n: i64):
  %dstlen = core.call @__hlir_strlen(%dst) : i64
  %srclen = core.call @__hlir_strlen(%src) : i64
  %lt = core.icmp ult %srclen, %n : bool
  %copylen = core.select %lt, %srclen, %n : i64
  %one = core.const 1 : i64
  %total = core.add %copylen, %one : i64
  %target = core.ptr_add %dst, %dstlen : ptr
  core.check.ptr_arith %dst, %dstlen
