}

// size_t fread(void *buf, size_t size, size_t nmemb, FILE *fp): writes up to size*nmemb attacker-controlled (file)
// bytes into buf, returns nmemb (worst case: a full read -- real fread can short-read on EOF/error, but that only
// ever writes FEWER bytes, so modelling the full read is the useful case for finding overflow bugs; a size*nmemb==0
// call is a no-op per the real contract). The bytes come from __hlir_fill_file (same ModelDB `source` fgets uses,
// see libc.yaml), so they are tainted with the "file" label -- this plus the `getc`/`fgetc` models in libc.yaml are
// what make a zero-parameter, FILE*-driven entry (no caller-supplied buffer/length parameter at all, e.g. a CLI
// tool's `getc()`-in-a-loop parser) explorable with `--include-noarg`: the taint now originates from the call
// inside the function body, not from an entry parameter. See docs/DESIGN.md's CVE-2016-3186/gif2tiff ground-truth
// write-up for the diagnosis this model fixes.
core.func @fread(ptr, i64, i64, ptr) -> i64 {
^entry(%buf: ptr, %size: i64, %nmemb: i64, %fp: ptr):
  %total = core.mul %size, %nmemb : i64
  %z = core.const 0 : i64
  %empty = core.icmp eq %total, %z : bool
  core.cond_br %empty, ^done0, ^fill
^fill:
  core.check.null %buf
  core.check.uaf %buf
  core.check.oob %buf {w=1, access="w", origin="fread buffer start"}
  %one = core.const 1 : i64
  %lastoff = core.sub %total, %one : i64
  %last = core.ptr_add %buf, %lastoff : ptr
  core.check.ptr_arith %buf, %lastoff
  core.check.oob %last {w=1, access="w", origin="fread buffer end"}
  core.call @__hlir_fill_file(%buf, %total)
  core.return %nmemb
^done0:
  core.return %z
}

