core.func @isblank(i32) -> i32 {
^entry(%c: i32):
  %t1 = core.const 32 : i32
  %t2 = core.icmp eq %c, %t1 : bool
  %t3 = core.const 9 : i32
  %t4 = core.icmp eq %c, %t3 : bool
  %t5 = core.or %t2, %t4 : bool
  %r = core.b2i %t5 : i32
  core.return %r
}
core.func @tolower(i32) -> i32 {
^entry(%c: i32):
  %k65 = core.const 65 : i32
  %k90 = core.const 90 : i32
  %k32 = core.const 32 : i32
  %ge = core.icmp sge %c, %k65 : bool
  %le = core.icmp sle %c, %k90 : bool
  %up = core.and %ge, %le : bool
  %l = core.add %c, %k32 : i32
  %r = core.select %up, %l, %c : i32
  core.return %r
}
core.func @toupper(i32) -> i32 {
^entry(%c: i32):
  %k97 = core.const 97 : i32
  %k122 = core.const 122 : i32
  %k32 = core.const 32 : i32
  %ge = core.icmp sge %c, %k97 : bool
  %le = core.icmp sle %c, %k122 : bool
  %lo = core.and %ge, %le : bool
  %u = core.sub %c, %k32 : i32
  %r = core.select %lo, %u, %c : i32
  core.return %r
}

// ---- formatted output: the formatted text itself is not modelled (the buffer just receives a NUL terminator when
// there is room), but the return value IS modelled as a bounded, tainted nondet value -- not a hardcoded 0 -- because
// real snprintf returns "the length that WOULD have been written", independent of `n` and uncapped by it (glibc:
// truncation does not cap the return value). Code that chains `p += snprintf(p, remaining, ...)` to advance a write
// pointer relies on exactly this property; with a hardcoded 0 that pattern's `p` never moves and the resulting
// out-of-bounds-pointer bugs (e.g. CVE-2017-7376, docs/DESIGN.md Sec.22.205/22.298) are structurally unreachable. We
// still don't model "how many bytes were actually written" -- we don't need to: once `p` has been driven past the
// real buffer by accumulated over-large returns, the NEXT call's unconditional core.check.oob on %buf (below) is what
// catches the resulting out-of-bounds write; this function doesn't need to understand `n` at all for that to work.
// The nondet is clamped into [0, kSnprintfWouldWriteCap] (64KiB): large enough to blow past realistic small buffers
// after a handful of accumulated calls, small enough to keep the symbolic range from being pathological for the
// solver. Tainted with a dedicated "fmt" label (not "env"/a real source label) so findings reached through it are
// honestly attributed to "format-length uncertainty", not literal attacker-controlled bytes.
core.func @snprintf(ptr, i64, ptr, ptr) -> i32 {
^entry(%buf: ptr, %n: i64, %fmt: ptr, %va: ptr):
  %z = core.const 0 : i64
  %has = core.icmp ne %n, %z : bool
  core.cond_br %has, ^put, ^out
^put:
  core.check.null %buf
  core.check.uaf %buf
  core.check.oob %buf {w=1, access="w", origin="snprintf buffer"}
  %nul = core.const 0 : i8
  core.store %nul, %buf {waived="checked above"}
  core.br ^out
^out:
  %rn = core.nondet {name="snprintf_wouldwrite", taint="fmt"} : i32
  %rzero = core.const 0 : i32
  %rcap = core.const 65536 : i32
  %rneg = core.icmp slt %rn, %rzero : bool
  %rnn = core.select %rneg, %rzero, %rn : i32
  %rover = core.icmp sgt %rnn, %rcap : bool
  %r = core.select %rover, %rcap, %rnn : i32
  core.return %r
}
core.func @vsnprintf(ptr, i64, ptr, ptr) -> i32 {
^entry(%buf: ptr, %n: i64, %fmt: ptr, %ap: ptr):
  %r = core.call @snprintf(%buf, %n, %fmt, %ap) : i32
  core.return %r
}
core.func @sprintf(ptr, ptr, ptr) -> i32 {
^entry(%buf: ptr, %fmt: ptr, %va: ptr):
  core.check.null %buf
  core.check.uaf %buf
  core.check.oob %buf {w=1, access="w", origin="sprintf buffer"}
  %nul = core.const 0 : i8
  core.store %nul, %buf {waived="checked above"}
  %r = core.const 0 : i32
  core.return %r
}

// ---- string comparison and search: exact loops (every byte read is checked, an unterminated string is an oob_read). Opaque versions
// would let `strncmp(p, "-->", 3) == 0` hold anywhere and parsers would walk off their buffers.
// ASCII lowercase of one byte, for the case-insensitive comparisons below.
core.func @__hlir_tolower(i64) -> i64 {
^entry(%c: i64):
  %a = core.const 65 : i64
  %z = core.const 90 : i64
  %ge = core.icmp uge %c, %a : bool
  %le = core.icmp ule %c, %z : bool
  %isup = core.and %ge, %le : bool
  %d = core.const 32 : i64
  %lo = core.add %c, %d : i64
  %r = core.select %isup, %lo, %c : i64
  core.return %r
}

// int strcasecmp(const char *, const char *) / strncasecmp: the case-insensitive comparisons every
// configuration parser is built from. Unmodelled they return an unconstrained value, so each keyword
// match is decided concretely and the branch behind it folds: measured on libssh's
// ssh_config_parse_string, which reached 13% of the branches in the functions it entered while
// `strcasecmp` was opaque (DESIGN.md Sec.22.491). They are written as @strcmp is, with both bytes
// folded to lowercase first -- the comparison stays byte-by-byte and symbolic.
core.func @strcasecmp(ptr, ptr) -> i32 {
^entry(%a: ptr, %b: ptr):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %ra = core.call @__hlir_cbyte(%a, %i) : i64
  %rb = core.call @__hlir_cbyte(%b, %i) : i64
  %ca = core.call @__hlir_tolower(%ra) : i64
  %cb = core.call @__hlir_tolower(%rb) : i64
  %ne = core.icmp ne %ca, %cb : bool
  core.cond_br %ne, ^diff, ^same
^same:
  %z2 = core.const 0 : i64
  %end = core.icmp eq %ca, %z2 : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %end, ^eq, ^loop(%in)
^eq:
  %zero = core.const 0 : i32
  core.return %zero
^diff:
  %d = core.sub %ca, %cb : i64
  %r = core.trunc %d : i32
  core.return %r
}

core.func @strncasecmp(ptr, ptr, i64) -> i32 {
^entry(%a: ptr, %b: ptr, %n: i64):
  %z = core.const 0 : i64
  %none = core.icmp eq %n, %z : bool
  core.cond_br %none, ^eq, ^loop(%z)
^loop(%i: i64):
  %done = core.icmp uge %i, %n : bool
  core.cond_br %done, ^eq, ^step(%i)
^step(%j: i64):
  %ra = core.call @__hlir_cbyte(%a, %j) : i64
  %rb = core.call @__hlir_cbyte(%b, %j) : i64
  %ca = core.call @__hlir_tolower(%ra) : i64
  %cb = core.call @__hlir_tolower(%rb) : i64
  %ne = core.icmp ne %ca, %cb : bool
  core.cond_br %ne, ^diff, ^same
^same:
  %z2 = core.const 0 : i64
  %end = core.icmp eq %ca, %z2 : bool
  %one = core.const 1 : i64
  %jn = core.add %j, %one : i64
  core.cond_br %end, ^eq, ^loop(%jn)
^eq:
  %zero = core.const 0 : i32
  core.return %zero
^diff:
  %d = core.sub %ca, %cb : i64
  %r = core.trunc %d : i32
  core.return %r
}

// BSD/Windows spellings of the same two.
core.func @stricmp(ptr, ptr) -> i32 {
^entry(%a: ptr, %b: ptr):
  %r = core.call @strcasecmp(%a, %b) : i32
  core.return %r
}
core.func @strnicmp(ptr, ptr, i64) -> i32 {
^entry(%a: ptr, %b: ptr, %n: i64):
  %r = core.call @strncasecmp(%a, %b, %n) : i32
  core.return %r
}

core.func @strcmp(ptr, ptr) -> i32 {
^entry(%a: ptr, %b: ptr):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %ca = core.call @__hlir_cbyte(%a, %i) : i64
  %cb = core.call @__hlir_cbyte(%b, %i) : i64
  %ne = core.icmp ne %ca, %cb : bool
  core.cond_br %ne, ^diff, ^same
^same:
  %z2 = core.const 0 : i64
  %end = core.icmp eq %ca, %z2 : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %end, ^eq, ^loop(%in)
^eq:
  %zero = core.const 0 : i32
  core.return %zero
^diff:
  %d = core.sub %ca, %cb : i64
  %r = core.trunc %d : i32
  core.return %r
}

core.func @strncmp(ptr, ptr, i64) -> i32 {
^entry(%a: ptr, %b: ptr, %n: i64):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %done = core.icmp uge %i, %n : bool
  core.cond_br %done, ^eq, ^body
^body:
  %ca = core.call @__hlir_cbyte(%a, %i) : i64
  %cb = core.call @__hlir_cbyte(%b, %i) : i64
  %ne = core.icmp ne %ca, %cb : bool
  core.cond_br %ne, ^diff, ^same
^same:
  %z2 = core.const 0 : i64
  %end = core.icmp eq %ca, %z2 : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %end, ^eq, ^loop(%in)
^eq:
  %zero = core.const 0 : i32
  core.return %zero
^diff:
  %d = core.sub %ca, %cb : i64
  %r = core.trunc %d : i32
  core.return %r
}

core.func @strchr(ptr, i32) -> ptr {
^entry(%s: ptr, %c: i32):
  %cc = core.zext %c : i64
  %m = core.const 255 : i64
  %cm = core.and %cc, %m : i64
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %b = core.call @__hlir_cbyte(%s, %i) : i64
  %hit = core.icmp eq %b, %cm : bool
  core.cond_br %hit, ^found, ^next
^found:
  %p = core.ptr_add %s, %i {waived="the byte was just read"} : ptr
  core.return %p
^next:
  %z2 = core.const 0 : i64
  %end = core.icmp eq %b, %z2 : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %end, ^none, ^loop(%in)
^none:
  %zero = core.const 0 : i64
  %np = core.int_to_ptr %zero : ptr
  core.return %np
}

// void *memchr(const void *s, int c, size_t n): the first byte in the first n bytes of s equal to (unsigned char)c, or NULL.
core.func @memchr(ptr, i32, i64) -> ptr {
^entry(%s: ptr, %c: i32, %n: i64):
  %cc = core.zext %c : i64
  %m = core.const 255 : i64
  %cm = core.and %cc, %m : i64
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %done = core.icmp uge %i, %n : bool
  core.cond_br %done, ^none, ^body
^body:
  %b = core.call @__hlir_cbyte(%s, %i) : i64
  %hit = core.icmp eq %b, %cm : bool
  core.cond_br %hit, ^found, ^next
^found:
  %p = core.ptr_add %s, %i {waived="the byte was just read"} : ptr
  core.return %p
^next:
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.br ^loop(%in)
^none:
  %zero = core.const 0 : i64
  %np = core.int_to_ptr %zero : ptr
  core.return %np
}

// void *memmem(const void *h, size_t hl, const void *n, size_t nl): the first occurrence of the nl bytes of n inside
// the first hl bytes of h -- a pointer into h, never another object -- or NULL; nl == 0 returns h (glibc). Without
// this model the opaque-external default returned an unrelated object and every `p - h` after it was a spurious
// ptr_cmp_diff_obj (c-ares ares_buf_consume_until_seq, DESIGN.md).
core.func @memmem(ptr, i64, ptr, i64) -> ptr {
^entry(%h: ptr, %hl: i64, %n: ptr, %nl: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %nl, %z : bool
  core.cond_br %empty, ^whole, ^check
^whole:
  core.return %h
^check:
  %fits = core.icmp ule %nl, %hl : bool
  core.cond_br %fits, ^outer(%z), ^none
^outer(%i: i64):
  %end = core.add %i, %nl : i64
  %ok = core.icmp ule %end, %hl : bool
  core.cond_br %ok, ^try(%i), ^none
^try(%ti: i64):
  // i + nl <= hl was just checked, so the nl bytes at h+i are inside the caller's own length bound.
  %hp = core.ptr_add %h, %ti {waived="i+nl <= hl was just checked"} : ptr
  %m = core.call @__hlir_memeq(%hp, %n, %nl) : i64
  %one = core.const 1 : i64
  %same = core.icmp eq %m, %one : bool
  core.cond_br %same, ^found(%ti), ^next(%ti)
^next(%ni: i64):
  %one2 = core.const 1 : i64
  %i1 = core.add %ni, %one2 : i64
  core.br ^outer(%i1)
^found(%fi: i64):
  %p = core.ptr_add %h, %fi {waived="the nl bytes at fi were just read"} : ptr
  core.return %p
^none:
  %zero = core.const 0 : i64
  %np = core.int_to_ptr %zero : ptr
  core.return %np
}

core.func @memcmp(ptr, ptr, i64) -> i32 {
^entry(%a: ptr, %b: ptr, %n: i64):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %done = core.icmp uge %i, %n : bool
  core.cond_br %done, ^eq, ^body
^body:
  %ca = core.call @__hlir_cbyte(%a, %i) : i64
  %cb = core.call @__hlir_cbyte(%b, %i) : i64
  %ne = core.icmp ne %ca, %cb : bool
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.cond_br %ne, ^diff, ^loop(%in)
^eq:
  %zero = core.const 0 : i32
  core.return %zero
^diff:
  %d = core.sub %ca, %cb : i64
  %r = core.trunc %d : i32
  core.return %r
}

// char *strstr(const char *h, const char *n): the first occurrence of n in h, or NULL.
// int __hlir_memeq(const void *a, const void *b, size_t n): 1 iff the n bytes at a and b are equal, else 0.
// The engine answers this branch-free when n is constant and all n bytes on both sides are provably readable
// (Machine::memEqFast, DESIGN.md §22.393) -- one conjunction instead of n `core.cond_br`. This body is the
// fallback, and it is deliberately LAZY: it stops at the first mismatch, so it never reads a byte the caller's
// own loop would not have read, and the bounds check inside __hlir_cbyte stays exactly where it was.
core.func @__hlir_memeq(ptr, ptr, i64) -> i64 {
^entry(%a: ptr, %b: ptr, %n: i64):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%k: i64):
  %done = core.icmp uge %k, %n : bool
  core.cond_br %done, ^yes, ^cmp
^cmp:
  %x = core.call @__hlir_cbyte(%a, %k) : i64
  %y = core.call @__hlir_cbyte(%b, %k) : i64
  %same = core.icmp eq %x, %y : bool
  %one = core.const 1 : i64
  %k1 = core.add %k, %one : i64
  core.cond_br %same, ^loop(%k1), ^no
^yes:
  %t = core.const 1 : i64
  core.return %t
^no:
  core.return %z
}

core.func @strstr(ptr, ptr) -> ptr {
^entry(%h: ptr, %n: ptr):
  %nl = core.call @__hlir_strlen(%n) : i64
  %z = core.const 0 : i64
  core.br ^outer(%z)
^outer(%i: i64):
  %ch = core.call @__hlir_cbyte(%h, %i) : i64
  %atend = core.icmp eq %ch, %z : bool
  core.cond_br %atend, ^tail, ^try
^tail:
  %emptyn = core.icmp eq %nl, %z : bool
  core.cond_br %emptyn, ^found, ^none
^try:
  // h+i is already validated: ^outer just read h[i] through __hlir_cbyte, which bounds-checked it.
  %hp = core.ptr_add %h, %i {waived="the byte at i was just read"} : ptr
  %m = core.call @__hlir_memeq(%hp, %n, %nl) : i64
  %one = core.const 1 : i64
  %eq = core.icmp eq %m, %one : bool
  core.cond_br %eq, ^found2(%i), ^advance(%i)
^advance(%bb: i64):
  %one2 = core.const 1 : i64
  %nx = core.add %bb, %one2 : i64
  core.br ^outer(%nx)
^found:
  core.return %h
^found2(%fb: i64):
  %fp = core.ptr_add %h, %fb {waived="the bytes were just read"} : ptr
  core.return %fp
^none:
  %zero = core.const 0 : i64
  %np = core.int_to_ptr %zero : ptr
  core.return %np
}

// ---- wl_list (libwayland's intrusive doubly linked list, wayland-util.h: `struct wl_list { struct wl_list *prev,
// *next; }`, prev at offset 0, next at offset 8): declared only -- the real bodies live in libwayland's own
// wayland-util.c, which isn't part of the analysed module (only a prebuilt .so is linked). Without a model these fall
// back to opaque (an unconstrained result each call, no effect on memory), and that breaks any loop that terminates
// by testing the list's own linkage: a `while (!wl_list_empty(&head))` on a list the harness correctly built as
// empty (self-referential: next == prev == &head) still "looks" non-empty to an opaque wl_list_empty() on every
// call, since opaque ignores what's actually in memory -- the loop never terminates and only stops at the step limit
// (DESIGN.md §22.26; the companion fix there for wl_resource_from_link/wl_resource_get_link covers the
// `wl_resource_for_each` case, this one covers direct `wl_list_*` use). Modelled with the real field layout and the
// real bodies (down to wl_list_remove leaving elm->prev/next NULL, matching wayland-util.c exactly), so the
// self-referential-empty invariant and real insert/remove linkage are exact, not approximated.

// int wl_list_empty(const struct wl_list *list) -- return list->next == list
core.func @wl_list_empty(ptr) -> i32 {
^entry(%list: ptr):
  core.check.null %list
  core.check.uaf %list
  %o8 = core.const 8 : i64
  %nextp = core.ptr_add %list, %o8 : ptr
  core.check.oob %nextp {w=8, access="r", origin="wl_list_empty"}
  %next = core.load %nextp {waived="checked above"} : ptr
  %eq = core.ptr_cmp eq %next, %list : bool
  %r = core.b2i %eq : i32
  core.return %r
}

// void wl_list_init(struct wl_list *list) -- list->prev = list->next = list (the empty-list invariant)
core.func @wl_list_init(ptr) -> void {
^entry(%list: ptr):
  core.check.null %list
  core.check.uaf %list
  core.check.oob %list {w=8, access="w", origin="wl_list_init prev"}
  core.store %list, %list {waived="checked above"}
  %o8 = core.const 8 : i64
  %nextp = core.ptr_add %list, %o8 : ptr
  core.check.oob %nextp {w=8, access="w", origin="wl_list_init next"}
  core.store %list, %nextp {waived="checked above"}
  core.return
}

// void wl_list_insert(struct wl_list *list, struct wl_list *elm) -- links elm right after list
core.func @wl_list_insert(ptr, ptr) -> void {
^entry(%list: ptr, %elm: ptr):
  core.check.null %list
  core.check.uaf %list
  core.check.null %elm
  core.check.uaf %elm
  %o8 = core.const 8 : i64
  %list_nextp = core.ptr_add %list, %o8 : ptr
  core.check.oob %list_nextp {w=8, access="r", origin="wl_list_insert list->next"}
  %list_next = core.load %list_nextp {waived="checked above"} : ptr
  core.check.oob %elm {w=8, access="w", origin="wl_list_insert elm->prev"}
  core.store %list, %elm {waived="checked above"}
  %elm_nextp = core.ptr_add %elm, %o8 : ptr
  core.check.oob %elm_nextp {w=8, access="w", origin="wl_list_insert elm->next"}
  core.store %list_next, %elm_nextp {waived="checked above"}
  core.store %elm, %list_nextp {waived="checked above"}
  core.check.null %list_next
  core.check.uaf %list_next
  core.check.oob %list_next {w=8, access="w", origin="wl_list_insert list_next->prev"}
  core.store %elm, %list_next {waived="checked above"}
  core.return
}

// void wl_list_remove(struct wl_list *elm) -- unlinks elm; elm->prev/next become NULL (matching wayland-util.c)
core.func @wl_list_remove(ptr) -> void {
^entry(%elm: ptr):
  core.check.null %elm
  core.check.uaf %elm
  core.check.oob %elm {w=8, access="r", origin="wl_list_remove elm->prev"}
  %prev = core.load %elm {waived="checked above"} : ptr
  %o8 = core.const 8 : i64
  %elm_nextp = core.ptr_add %elm, %o8 : ptr
  core.check.oob %elm_nextp {w=8, access="r", origin="wl_list_remove elm->next"}
  %next = core.load %elm_nextp {waived="checked above"} : ptr
  core.check.null %prev
  core.check.uaf %prev
  %prev_nextp = core.ptr_add %prev, %o8 : ptr
  core.check.oob %prev_nextp {w=8, access="w", origin="wl_list_remove prev->next"}
  core.store %next, %prev_nextp {waived="checked above"}
  core.check.null %next
  core.check.uaf %next
  core.check.oob %next {w=8, access="w", origin="wl_list_remove next->prev"}
  core.store %prev, %next {waived="checked above"}
  %z = core.const 0 : i64
  %np = core.int_to_ptr %z : ptr
  core.store %np, %elm_nextp {waived="checked above"}
  core.store %np, %elm {waived="checked above"}
  core.return
}

// ---------------------------------------------------------------- option parsing and the file descriptor calls
//
// int getopt(int argc, char * const argv[], const char *optstring)
//
// The harness starts an initialiser with argc = 1 and argv = { "prog", NULL } (HarnessGen, DESIGN.md §22.368 §2):
// a program invoked with no options. For THAT input `-1` ("no more options") is not an approximation, it is the
// correct answer, and `optarg` staying NULL is correct too. Analysing a module as if it had been given options is
// a different configuration and belongs in a per-configuration prologue (§22.368 §6), not in this model.
//
// Why it matters enough to model at all: a QNX resource manager's `main` is
// `while ((c = getopt(argc, argv, "...")) != -1) switch (c) { ... }`. Left opaque, the return value is
// unconstrained, so that loop condition is symbolic and the explorer forks on it every iteration while `optarg`
// -- a GLOBAL the opaque call does not write -- stays at its static initialiser, which then reads as NULL. The
// initialiser burns its budget in the option loop and never reaches the code that sets the module up.
// (the real implementation is at the end of this file, DESIGN.md §22.380)

// int getopt_long(int argc, char * const argv[], const char *optstring, const struct option *longopts, int *longindex)
core.func @getopt_long(i32, ptr, ptr, ptr, ptr) -> i32 {
^entry(%argc: i32, %argv: ptr, %optstring: ptr, %longopts: ptr, %longindex: ptr):
  %r = core.call @getopt(%argc, %argv, %optstring) : i32
  core.return %r
}

// ssize_t write(int fd, const void *buf, size_t count)
//
// Modelled for the CHECK, not for the return value: `write` reads `count` bytes out of `buf`, so a bad length is
// an out-of-bounds READ of the caller's buffer and this is where it is detected. Left opaque the call has "no
// effect on memory" and that defect is invisible. Mirrors the `_copy_from_user` model's shape (linux.core).
core.func @write(i32, ptr, i64) -> i64 {
^entry(%fd: i32, %buf: ptr, %count: i64):
  %z = core.const 0 : i64
  %empty = core.icmp eq %count, %z : bool
  core.cond_br %empty, ^done, ^go
^go:
  core.check.null %buf
  core.check.uaf %buf
  %one = core.const 1 : i64
  %last = core.sub %count, %one : i64
  %end = core.ptr_add %buf, %last : ptr
  core.check.ptr_arith %buf, %last
  core.check.oob %buf {w=1, access="r", origin="write source start"}
  core.check.oob %end {w=1, access="r", origin="write source end"}
  core.br ^done
^done:
  // -1 (error) .. count: the caller must handle a short write, and a model that always succeeded would hide the
  // bug in code that does not.
  %r = core.nondet {name="write_result"} : i64
  core.return %r
}

// int open(const char *path, int oflag, ...) / int close(int fd): no memory effect beyond reading the path, which
// the caller owns; modelled only so the fd is a plain unconstrained int rather than an unmodelled-external stop
// under --strict-externs.
core.func @close(i32) -> i32 {
^entry(%fd: i32):
  %r = core.nondet {name="close_result"} : i32
  core.return %r
}

// ---------------------------------------------------------------- a real getopt (DESIGN.md §22.380)
//
// Replaces the stub above, which returned -1 unconditionally. That stub was not an approximation of anything: it
// asserted "this program was started with no options", and for a program whose options are MANDATORY the
// assertion is simply false. Measured on <driver>: `main` returned at its first check -- `<driver>`
// rejecting `ctrl_num == INVALID_CTRL_NUM` -- so the entire initialiser was skipped, every global stayed at its
// static value, and all six handlers were vacuous safes. Nothing in the report named it.
//
// With `argv:` stated in the project's externs file the command line is CONCRETE, so this can be an ordinary
// interpreter of it rather than anything symbolic: the initialiser runs once, with the arguments the program is
// really launched with, and every branch it takes is the branch the real program takes.
//
// Scope, stated rather than implied:
//   * short options only, with POSIX's `c` / `c:` optstring, and both `-c0` and `-c 0` spellings of an argument;
//   * a leading `:` in optstring (silent-error mode) is accepted and ignored -- '?' is returned either way;
//   * the FIRST non-option word ends the scan (POSIX behaviour, not glibc's permutation). Every resource manager
//     in the tree passes its options first, so permuting would change nothing it does;
//   * `--` ends the scan, consuming itself;
//   * no long options -- `getopt_long` below still forwards here, so a module that really uses long options gets
//     the short-option answer for them, which is '?' rather than the right letter. That is a gap, not a silence:
//     it shows up as the module taking its "invalid usage" path, which is visible in coverage.
//
// `optind` and the within-word position are the real globals, so repeated calls advance exactly as the C library
// does. glibc treats `optind == 0` as "reset"; here a zero also just means "nobody initialised it", and both want
// the same thing -- start at argv[1].
core.func @__hlir_getopt_scan(ptr, i8) -> i64 {
^entry(%optstring: ptr, %c: i8):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %p = core.ptr_add %optstring, %i : ptr
  core.check.oob %p {w=1, access="r", origin="getopt optstring"}
  %ch = core.load %p {waived="checked above"} : i8
  %nul = core.const 0 : i8
  %end = core.icmp eq %ch, %nul : bool
  core.cond_br %end, ^miss, ^test
^test:
  %hit = core.icmp eq %ch, %c : bool
  core.cond_br %hit, ^found, ^next
^next:
  %one = core.const 1 : i64
  %i2 = core.add %i, %one : i64
  core.br ^loop(%i2)
^found:
  %one2 = core.const 1 : i64
  %j = core.add %i, %one2 : i64
  %q = core.ptr_add %optstring, %j : ptr
  core.check.oob %q {w=1, access="r", origin="getopt optstring"}
  %nx = core.load %q {waived="checked above"} : i8
  %colon = core.const 58 : i8
  %needs = core.icmp eq %nx, %colon : bool
  core.cond_br %needs, ^witharg, ^noarg
^witharg:
  %two = core.const 2 : i64
  core.return %two
^noarg:
  %one3 = core.const 1 : i64
  core.return %one3
^miss:
  %zz = core.const 0 : i64
  core.return %zz
}

core.func @getopt(i32, ptr, ptr) -> i32 {
^entry(%argc: i32, %argv: ptr, %optstring: ptr):
  %pind = core.global_addr @optind {size=4} : ptr
  %ppos = core.global_addr @__hlir_optpos {size=4} : ptr
  %parg = core.global_addr @optarg {size=8} : ptr
  %popt = core.global_addr @optopt {size=4} : ptr
  %i0 = core.load %pind {waived="object known"} : i32
  %p0 = core.load %ppos {waived="object known"} : i32
  %c0 = core.const 0 : i32
  %c1 = core.const 1 : i32
  %indz = core.icmp eq %i0, %c0 : bool
  %ind = core.select %indz, %c1, %i0 : i32
  %posz = core.icmp eq %p0, %c0 : bool
  %pos = core.select %posz, %c1, %p0 : i32
  core.br ^word(%ind, %pos)
^word(%wi: i32, %wp: i32):
  %done = core.icmp sge %wi, %argc : bool
  core.cond_br %done, ^stop, ^have
^have:
  core.store %wi, %pind {waived="object known"}
  %wi64 = core.sext %wi : i64
  %eight = core.const 8 : i64
  %voff = core.mul %wi64, %eight : i64
  %vp = core.ptr_add %argv, %voff : ptr
  core.check.oob %vp {w=8, access="r", origin="getopt argv[optind]"}
  %w = core.load %vp {waived="checked above"} : ptr
  %isnull = core.is_null %w : bool
  core.cond_br %isnull, ^stop, ^notnull
^notnull:
  %zo = core.const 0 : i64
  %w0p = core.ptr_add %w, %zo : ptr
  core.check.oob %w0p {w=1, access="r", origin="getopt argv word"}
  %w0 = core.load %w0p {waived="checked above"} : i8
  %dash = core.const 45 : i8
  %isdash = core.icmp eq %w0, %dash : bool
  core.cond_br %isdash, ^dashed, ^stop
^dashed:
  %oneo = core.const 1 : i64
  %w1p = core.ptr_add %w, %oneo : ptr
  core.check.oob %w1p {w=1, access="r", origin="getopt argv word"}
  %w1 = core.load %w1p {waived="checked above"} : i8
  %nul0 = core.const 0 : i8
  %bare = core.icmp eq %w1, %nul0 : bool
  core.cond_br %bare, ^stop, ^notbare
^notbare:
  %isdash2 = core.icmp eq %w1, %dash : bool
  core.cond_br %isdash2, ^maybeend, ^letter
^maybeend:
  %twoo = core.const 2 : i64
  %w2p = core.ptr_add %w, %twoo : ptr
  core.check.oob %w2p {w=1, access="r", origin="getopt argv word"}
  %w2 = core.load %w2p {waived="checked above"} : i8
  %isend = core.icmp eq %w2, %nul0 : bool
  core.cond_br %isend, ^consume, ^letter
^consume:
  %wi1 = core.add %wi, %c1 : i32
  core.store %wi1, %pind {waived="object known"}
  core.store %c1, %ppos {waived="object known"}
  %m1a = core.const -1 : i32
  core.return %m1a
^letter:
  %wp64 = core.sext %wp : i64
  %cp = core.ptr_add %w, %wp64 : ptr
  core.check.oob %cp {w=1, access="r", origin="getopt option letter"}
  %c = core.load %cp {waived="checked above"} : i8
  %spent = core.icmp eq %c, %nul0 : bool
  core.cond_br %spent, ^nextword, ^opt
^nextword:
  %wiN = core.add %wi, %c1 : i32
  core.store %c1, %ppos {waived="object known"}
  core.br ^word(%wiN, %c1)
^opt:
  %wpN = core.add %wp, %c1 : i32
  core.store %wpN, %ppos {waived="object known"}
  %kind = core.call @__hlir_getopt_scan(%optstring, %c) : i64
  %ci = core.zext %c : i32
  %zero64 = core.const 0 : i64
  %unknown = core.icmp eq %kind, %zero64 : bool
  core.cond_br %unknown, ^bad, ^known
^bad:
  core.store %ci, %popt {waived="object known"}
  %qm = core.const 63 : i32
  core.return %qm
^known:
  %two64 = core.const 2 : i64
  %takes = core.icmp eq %kind, %two64 : bool
  core.cond_br %takes, ^argneeded, ^plain
^plain:
  core.return %ci
^argneeded:
  %wpN64 = core.sext %wpN : i64
  %restp = core.ptr_add %w, %wpN64 : ptr
  core.check.oob %restp {w=1, access="r", origin="getopt attached argument"}
  %rest = core.load %restp {waived="checked above"} : i8
  %empty = core.icmp eq %rest, %nul0 : bool
  core.cond_br %empty, ^separate, ^attached
^attached:
  core.store %restp, %parg {waived="object known"}
  %wiA = core.add %wi, %c1 : i32
  core.store %wiA, %pind {waived="object known"}
  core.store %c1, %ppos {waived="object known"}
  core.return %ci
^separate:
  %wiS = core.add %wi, %c1 : i32
  %noarg = core.icmp sge %wiS, %argc : bool
  core.cond_br %noarg, ^missing, ^takeit
^missing:
  core.store %wiS, %pind {waived="object known"}
  core.store %c1, %ppos {waived="object known"}
  core.store %ci, %popt {waived="object known"}
  %qm2 = core.const 63 : i32
  core.return %qm2
^takeit:
  %wiS64 = core.sext %wiS : i64
  %eight2 = core.const 8 : i64
  %aoff = core.mul %wiS64, %eight2 : i64
  %ap = core.ptr_add %argv, %aoff : ptr
  core.check.oob %ap {w=8, access="r", origin="getopt argv[optind]"}
  %aw = core.load %ap {waived="checked above"} : ptr
  core.store %aw, %parg {waived="object known"}
  %wiT = core.add %wiS, %c1 : i32
  core.store %wiT, %pind {waived="object known"}
  core.store %c1, %ppos {waived="object known"}
  core.return %ci
^stop:
  core.store %wi, %pind {waived="object known"}
  core.store %c1, %ppos {waived="object known"}
  %m1 = core.const -1 : i32
  core.return %m1
}

// ---- byte order: ntohs/ntohl/htons/htonl (and the BSD/glibc bswap spellings).
//
// These are PURE byte permutations, but left unmodelled they are opaque externs returning an "arbitrary
// untainted" value -- which cuts taint at every multi-byte field a network parser extracts. Measured on
// tcpdump's VQP printer: ntohl opaque for 100 calls and ntohs for 25, after which the TLV length fields the
// defect depends on carried no taint at all, the search bottomed out after 78 runs at 97/267 blocks, and the
// scan reported `safe` (DESIGN.md §22.408). This is the §22.388 pathology in a different costume.
//
// Written for a LITTLE-ENDIAN host, which is what every target in this corpus is built for; on a big-endian
// host these are the identity and the model would be wrong. That restriction is deliberate and stated rather
// than hidden behind a configure-time guess.
core.func @ntohs(i16) -> i16 {
^entry(%x: i16):
  %c8 = core.const 8 : i16
  %hi = core.shl %x, %c8 : i16
  %lo = core.lshr %x, %c8 : i16
  %r = core.or %hi, %lo : i16
  core.return %r
}

core.func @htons(i16) -> i16 {
^entry(%x: i16):
  %r = core.call @ntohs(%x) : i16
  core.return %r
}

core.func @ntohl(i32) -> i32 {
^entry(%x: i32):
  %c8 = core.const 8 : i32
  %c24 = core.const 24 : i32
  %mff = core.const 255 : i32
  %mff00 = core.const 65280 : i32
  %b0 = core.and %x, %mff : i32
  %r0 = core.shl %b0, %c24 : i32
  %b1 = core.and %x, %mff00 : i32
  %r1 = core.shl %b1, %c8 : i32
  %s1 = core.lshr %x, %c8 : i32
  %r2 = core.and %s1, %mff00 : i32
  %s2 = core.lshr %x, %c24 : i32
  %r3 = core.and %s2, %mff : i32
  %o1 = core.or %r0, %r1 : i32
  %o2 = core.or %r2, %r3 : i32
  %r = core.or %o1, %o2 : i32
  core.return %r
}

core.func @htonl(i32) -> i32 {
^entry(%x: i32):
  %r = core.call @ntohl(%x) : i32
  core.return %r
}

// ---- strlcpy / strlcat (BSD, and widely vendored -- tcpdump uses them throughout util-print.c).
//
// Left unmodelled they are opaque externs: the destination is never written in the model, and the RETURN
// value -- which is what every caller uses to detect truncation and which may legitimately EXCEED `size` --
// comes back as an arbitrary untainted integer, cutting taint at exactly the length the caller then acts on.
// Same shape as the ntohs/ntohl gap of DESIGN.md §22.408.
//
// size_t strlcpy(char *dst, const char *src, size_t size): copies min(strlen(src), size-1) bytes and always
// terminates when size > 0; RETURNS strlen(src), i.e. the length it WANTED to write. Reading all of src is
// faithful: the real one calls strlen on it, so an unterminated src is a genuine over-read.
core.func @strlcpy(ptr, ptr, i64) -> i64 {
^entry(%dst: ptr, %src: ptr, %size: i64):
  %srclen = core.call @__hlir_strlen(%src) : i64
  %z = core.const 0 : i64
  %nospace = core.icmp eq %size, %z : bool
  core.cond_br %nospace, ^done, ^copy
^copy:
  core.check.null %dst
  core.check.uaf %dst
  %one = core.const 1 : i64
  %cap = core.sub %size, %one : i64
  %fits = core.icmp ule %srclen, %cap : bool
  core.cond_br %fits, ^whole, ^clipped
^whole:
  core.br ^write(%srclen)
^clipped:
  core.br ^write(%cap)
^write(%n: i64):
  core.check.ptr_arith %dst, %n
  %end = core.ptr_add %dst, %n : ptr
  core.check.oob %dst {w=1, access="w", origin="strlcpy destination start"}
  core.check.oob %end {w=1, access="w", origin="strlcpy terminator"}
  core.memcpy %dst, %src, %n
  %zb = core.const 0 : i8
  core.store %zb, %end {waived="checked above"}
  core.br ^done
^done:
  core.return %srclen
}

// size_t strlcat(char *dst, const char *src, size_t size): appends at the first NUL within the first `size`
// bytes of dst. RETURNS the length it wanted, which is dstlen + strlen(src) and may exceed `size`. When dst
// holds no NUL in `size` bytes the BSD contract is to return size + strlen(src) and write nothing.
core.func @strlcat(ptr, ptr, i64) -> i64 {
^entry(%dst: ptr, %src: ptr, %size: i64):
  %srclen = core.call @__hlir_strlen(%src) : i64
  %dstlen = core.call @__hlir_strnlen(%dst, %size) : i64
  %full = core.icmp uge %dstlen, %size : bool
  core.cond_br %full, ^unterm, ^append
^unterm:
  %r0 = core.add %size, %srclen : i64
  core.return %r0
^append:
  %one = core.const 1 : i64
  %left0 = core.sub %size, %dstlen : i64
  %left = core.sub %left0, %one : i64
  %fits = core.icmp ule %srclen, %left : bool
  core.cond_br %fits, ^whole, ^clipped
^whole:
  core.br ^write(%srclen)
^clipped:
  core.br ^write(%left)
^write(%n: i64):
  core.check.ptr_arith %dst, %dstlen
  %tail = core.ptr_add %dst, %dstlen : ptr
  core.check.ptr_arith %tail, %n
  %end = core.ptr_add %tail, %n : ptr
  core.check.oob %tail {w=1, access="w", origin="strlcat append point"}
  core.check.oob %end {w=1, access="w", origin="strlcat terminator"}
  core.memcpy %tail, %src, %n
  %zb = core.const 0 : i8
  core.store %zb, %end {waived="checked above"}
  %r1 = core.add %dstlen, %srclen : i64
  core.return %r1
}

// ---- strpbrk / strspn / strcspn: the character-class family (DESIGN.md §22.412).
//
// All three ask the same question once per input character -- "is this byte in that constant set?" -- which
// is exactly what Machine::charClassFast answers in closed form for @strchr (§22.385). So they are written
// to CALL @strchr on the set, and the fold comes for free: no second folding rule, no second oracle, and
// when the set is not a program constant they fall back to @strchr's loop like everything else.
//
// The c == 0 case is handled BEFORE the call on purpose: strchr(set, 0) legitimately returns the set's
// terminator, so asking it about the input's own terminator would report a match that is not one.

// char *strpbrk(const char *s, const char *accept): first byte of s that appears in accept, else NULL.
core.func @strpbrk(ptr, ptr) -> ptr {
^entry(%s: ptr, %acc: ptr):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %b = core.call @__hlir_cbyte(%s, %i) : i64
  %z64 = core.const 0 : i64
  %end = core.icmp eq %b, %z64 : bool
  core.cond_br %end, ^none, ^test
^test:
  %b32 = core.trunc %b : i32
  %hit = core.call @strchr(%acc, %b32) : ptr
  %isn = core.is_null %hit : bool
  core.cond_br %isn, ^next, ^found
^found:
  %p = core.ptr_add %s, %i {waived="the byte was just read"} : ptr
  core.return %p
^next:
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.br ^loop(%in)
^none:
  %zero = core.const 0 : i64
  %np = core.int_to_ptr %zero : ptr
  core.return %np
}

// size_t strspn(const char *s, const char *accept): length of the initial run of s made only of accept bytes.
core.func @strspn(ptr, ptr) -> i64 {
^entry(%s: ptr, %acc: ptr):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %b = core.call @__hlir_cbyte(%s, %i) : i64
  %z64 = core.const 0 : i64
  %end = core.icmp eq %b, %z64 : bool
  core.cond_br %end, ^done(%i), ^test
^test:
  %b32 = core.trunc %b : i32
  %hit = core.call @strchr(%acc, %b32) : ptr
  %isn = core.is_null %hit : bool
  core.cond_br %isn, ^done(%i), ^next
^next:
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.br ^loop(%in)
^done(%n: i64):
  core.return %n
}

// size_t strcspn(const char *s, const char *reject): length of the initial run of s free of reject bytes.
core.func @strcspn(ptr, ptr) -> i64 {
^entry(%s: ptr, %rej: ptr):
  %z = core.const 0 : i64
  core.br ^loop(%z)
^loop(%i: i64):
  %b = core.call @__hlir_cbyte(%s, %i) : i64
  %z64 = core.const 0 : i64
  %end = core.icmp eq %b, %z64 : bool
  core.cond_br %end, ^done(%i), ^test
^test:
  %b32 = core.trunc %b : i32
  %hit = core.call @strchr(%rej, %b32) : ptr
  %isn = core.is_null %hit : bool
  core.cond_br %isn, ^next, ^done(%i)
^next:
  %one = core.const 1 : i64
  %in = core.add %i, %one : i64
  core.br ^loop(%in)
^done(%n: i64):
  core.return %n
}


// void explicit_bzero(void *s, size_t n) / void bzero(void *, size_t): memset(s, 0, n) that the compiler may not
// optimise away. The "may not be optimised away" part is a compiler contract, not a semantic one, so for the engine
// these ARE memset -- and writing them as such matters because left opaque they write nothing, which keeps whatever
// the buffer held before and hides a use-after-scrub. libssh calls explicit_bzero on every key buffer it drops.
core.func @explicit_bzero(ptr, i64) -> void {
^entry(%s: ptr, %n: i64):
  %z = core.const 0 : i32
  %r = core.call @memset(%s, %z, %n) : ptr
  core.return
}

core.func @bzero(ptr, i64) -> void {
^entry(%s: ptr, %n: i64):
  %z = core.const 0 : i32
  %r = core.call @memset(%s, %z, %n) : ptr
  core.return
}

// char *strtok_r(char *s, const char *delim, char **save): the POSIX re-entrant tokeniser, written the way POSIX
// specifies it -- skip a run of delimiters (@strspn), take the run that is free of them (@strcspn), WRITE a NUL over
// the delimiter that ended the token, and leave the rest in *save. The write is the part a model must not skip: it
// is a store into the caller's buffer, and callers that hand strtok_r a string literal or a const buffer are a real
// defect class. It is bounds checked like any other store.
//
// Unmodelled it returns an unconstrained pointer and writes nothing, which cuts the taint: libssh's
// ssh_known_hosts_parse_line tokenises the known_hosts line it is handed, and with @strtok_r opaque the whole parse
// ran with checks_queried == 0 -- a vacuous scan that the acceptance gates caught (DESIGN.md Sec.22.488).
//
// @strtok (the non-reentrant one) is deliberately NOT here: its save slot is a hidden static, so modelling it means
// inventing a global, and every caller of it in one scan would then share that global's state.
core.func @strtok_r(ptr, ptr, ptr) -> ptr {
^entry(%s: ptr, %delim: ptr, %save: ptr):
  %isn = core.is_null %s : bool
  core.cond_br %isn, ^fromsave, ^have(%s)
^fromsave:
  core.check.null %save
  core.check.uaf %save
  core.check.oob %save {w=8, access="r", origin="strtok_r saveptr"}
  %sv = core.load %save {waived="checked above"} : ptr
  core.br ^have(%sv)
^have(%p: ptr):
  %nsp = core.call @strspn(%p, %delim) : i64
  core.check.ptr_arith %p, %nsp
  %q = core.ptr_add %p, %nsp : ptr
  %z = core.const 0 : i64
  %b = core.call @__hlir_cbyte(%q, %z) : i64
  %atend = core.icmp eq %b, %z : bool
  core.cond_br %atend, ^empty, ^tok
^empty:
  core.check.null %save
  core.check.uaf %save
  core.check.oob %save {w=8, access="w", origin="strtok_r *save"}
  core.store %q, %save {waived="checked above"}
  %np = core.int_to_ptr %z : ptr
  core.return %np
^tok:
  %len = core.call @strcspn(%q, %delim) : i64
  core.check.ptr_arith %q, %len
  %e = core.ptr_add %q, %len : ptr
  %eb = core.call @__hlir_cbyte(%e, %z) : i64
  %last = core.icmp eq %eb, %z : bool
  core.cond_br %last, ^store(%e), ^cut
^cut:
  core.check.oob %e {w=1, access="w", origin="strtok_r terminator"}
  %nul8 = core.const 0 : i8
  core.store %nul8, %e {waived="checked above"}
  %one = core.const 1 : i64
  core.check.ptr_arith %e, %one
  %nxt = core.ptr_add %e, %one : ptr
  core.br ^store(%nxt)
^store(%rest: ptr):
  core.check.null %save
  core.check.uaf %save
  core.check.oob %save {w=8, access="w", origin="strtok_r *save"}
  core.store %rest, %save {waived="checked above"}
  core.return %q
}

// ---------------------------------------------------------------------------------------------------------
// libdl. These had no model at all until now.
//
// MEASURED FIRST, and it corrected the reason for writing them. The expectation was that an unmodelled
// `dlopen` returns NULL, so the program takes its LOAD-FAILED branch and everything the shared object sets up
// is unreachable. That is wrong: an opaque external's pointer result is "NULL **or** a zeroed object", a
// nondet the search can flip, so the success branch was already reachable. On `test/c/scan/dlopenmod.c` the
// defect behind the dlopen gate is found either way.
//
// What the models actually buy, measured on that fixture: `opaque_calls` 3 -> 0 (dlopen/dlsym/dlclose stop
// being unexplained externals in every report that touches them) and blocks 11 -> 14. Worth having, and a
// smaller claim than the one this comment used to make.
//
// `fail=nondet` rather than "always succeeds": the failure branch is real code (dlerror handling, fallbacks)
// and is often reachable by an attacker. A nondet lets the search take BOTH, which is why no
// `dlopen_succeeds` narrowing has to be named. Same reasoning as @malloc.
//
// These models stop at the handle, and that is the part that matters for a real target: `dlsym` returns an
// address no call site can match, so the call through it is `__hlir_unknown_indirect` and the shared object's
// code stays invisible. Resolving a symbol NAME to the function the scan linked needs the engine, not a model
// body -- a model cannot read the module's symbol table (DESIGN.md §22.423).

// void *dlopen(const char *file, int mode)
core.func @dlopen(ptr, i32) -> ptr {
^entry(%f: ptr, %m: i32):
  %n = core.const 64 : i64
  %h = core.heap_alloc %n {fail=nondet, name="dlopen_fail"} : ptr
  core.return %h
}

// void *dlsym(void *handle, const char *name) — an opaque, possibly-NULL symbol address. A call through it
// has no candidate to match, so it becomes __hlir_unknown_indirect and the path continues.
core.func @dlsym(ptr, ptr) -> ptr {
^entry(%h: ptr, %n: ptr):
  %sz = core.const 1 : i64
  %p = core.heap_alloc %sz {fail=nondet, name="dlsym_fail"} : ptr
  core.return %p
}

// int dlclose(void *handle) — 0 on success. The handle is not freed here: a program that keeps using symbols
// after dlclose is doing something real, and turning it into a use-after-free would be our invention.
core.func @dlclose(ptr) -> i32 {
^entry(%h: ptr):
  %z = core.const 0 : i32
  core.return %z
}

// char *dlerror(void) — NULL when there is no error to report, else a message. Both are reachable.
core.func @dlerror() -> ptr {
^entry:
  %sz = core.const 1 : i64
  %p = core.heap_alloc %sz {fail=nondet, name="dlerror_none"} : ptr
  core.return %p
}

// =========================================================================================================
// POSIX threads. The scanner executes ONE thread, so the synchronisation primitives have no effect on the
// state an entry reads -- but "no effect" is not the same as "unmodelled": left opaque they return an
// arbitrary value, and libgit2's `git_mutex_lock(&x) < 0` error paths then become reachable on every call,
// while pthread_getspecific returns an unconstrained pointer that later gets dereferenced. Measured on
// libgit2's git_object__from_raw: pthread_mutex_lock/unlock/getspecific were three of the five unexplained
// externals in the first scan (DESIGN.md Sec.22.489).
//
// Each lock returns 0 (success). That IS a narrowing -- EDEADLK, EBUSY and EINVAL paths are not explored --
// and it is the right one for a single-threaded replay: a lock that fails in a program the scanner runs
// alone would be a defect of the model, not of the program.
core.func @pthread_mutex_lock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_mutex_unlock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_mutex_trylock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_mutex_init(ptr, ptr) -> i32 {
^entry(%m: ptr, %attr: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_mutex_destroy(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_rwlock_rdlock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_rwlock_wrlock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_rwlock_unlock(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_rwlock_init(ptr, ptr) -> i32 {
^entry(%m: ptr, %attr: ptr):
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_rwlock_destroy(ptr) -> i32 {
^entry(%m: ptr):
  %z = core.const 0 : i32
  core.return %z
}

// Thread-local storage, modelled for real rather than waved through, because it is STATE a parser reads:
// libgit2 keeps its error object in TLS (git_error_global_init -> git_tlsdata_init), and an unconstrained
// pointer out of pthread_getspecific is dereferenced on every git_error_set.
//
// One table of 16 slots, keys handed out in order. 16 is a real limit and a wrong answer past it is not
// acceptable, so key_create returns EAGAIN (11) when they run out and set/getspecific reject a key outside
// the table -- a program that uses 17 keys gets an honest failure instead of an aliased slot.
core.func @pthread_key_create(ptr, ptr) -> i32 {
^entry(%keyp: ptr, %dtor: ptr):
  %cnt = core.global_addr @__hlir_pthread_nkeys {size=4} : ptr
  %n = core.load %cnt {waived="object known"} : i32
  %max = core.const 16 : i32
  %full = core.icmp uge %n, %max : bool
  core.cond_br %full, ^oops, ^give
^oops:
  %eagain = core.const 11 : i32
  core.return %eagain
^give:
  %one = core.const 1 : i32
  %nn = core.add %n, %one : i32
  core.store %nn, %cnt {waived="object known"}
  core.check.null %keyp
  core.check.uaf %keyp
  core.check.oob %keyp {w=4, access="w", origin="pthread_key_create *key"}
  core.store %n, %keyp {waived="checked above"}
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_setspecific(i32, ptr) -> i32 {
^entry(%key: i32, %val: ptr):
  %max = core.const 16 : i32
  %bad = core.icmp uge %key, %max : bool
  core.cond_br %bad, ^inval, ^set
^inval:
  %einval = core.const 22 : i32
  core.return %einval
^set:
  %tls = core.global_addr @__hlir_pthread_tls {size=128} : ptr
  %k64 = core.zext %key : i64
  %eight = core.const 8 : i64
  %off = core.mul %k64, %eight : i64
  %slot = core.ptr_add %tls, %off {waived="key < 16 checked above"} : ptr
  core.store %val, %slot {waived="in-bounds by construction"}
  %z = core.const 0 : i32
  core.return %z
}
core.func @pthread_getspecific(i32) -> ptr {
^entry(%key: i32):
  %max = core.const 16 : i32
  %bad = core.icmp uge %key, %max : bool
  core.cond_br %bad, ^none, ^get
^none:
  %zz = core.const 0 : i64
  %np = core.int_to_ptr %zz : ptr
  core.return %np
^get:
  %tls = core.global_addr @__hlir_pthread_tls {size=128} : ptr
  %k64 = core.zext %key : i64
  %eight = core.const 8 : i64
  %off = core.mul %k64, %eight : i64
  %slot = core.ptr_add %tls, %off {waived="key < 16 checked above"} : ptr
  %v = core.load %slot {waived="in-bounds by construction"} : ptr
  core.return %v
}
core.func @pthread_key_delete(i32) -> i32 {
^entry(%key: i32):
  %max = core.const 16 : i32
  %bad = core.icmp uge %key, %max : bool
  core.cond_br %bad, ^inval, ^del
^inval:
  %einval = core.const 22 : i32
  core.return %einval
^del:
  %tls = core.global_addr @__hlir_pthread_tls {size=128} : ptr
  %k64 = core.zext %key : i64
  %eight = core.const 8 : i64
  %off = core.mul %k64, %eight : i64
  %slot = core.ptr_add %tls, %off {waived="key < 16 checked above"} : ptr
  %zz = core.const 0 : i64
  %np = core.int_to_ptr %zz : ptr
  core.store %np, %slot {waived="in-bounds by construction"}
  %z = core.const 0 : i32
  core.return %z
}

// pthread_self / pthread_equal: one thread, so one id. A constant rather than a nondet because a program
// that compares `pthread_self() == owner` must take the SAME branch every time it asks -- a nondet would
// let the solver say "a different thread" inside a single run, which cannot happen here.
core.func @pthread_self() -> i64 {
^entry:
  %id = core.const 1 : i64
  core.return %id
}
core.func @pthread_equal(i64, i64) -> i32 {
^entry(%a: i64, %b: i64):
  %eq = core.icmp eq %a, %b : bool
  %r = core.b2i %eq : i32
  core.return %r
}

// NOT MODELLED, on purpose: @pthread_once(once_control, init_routine).
//
// Its whole semantics is "call this function pointer exactly once", and `core.call` in this IR takes a
// SYMBOL, not a value -- there is no way to write an indirect call in a model body. The two things a model
// could do instead are both lies: setting *once to 1 without calling anything claims the initialisation
// ran, and leaving it alone claims it never will. So it stays opaque, and the correct fix for a library
// that initialises through pthread_once is the one the init work of Sec.22.488 is about: name the
// initialiser with `--init-fn`, which runs the real body in the real order.
