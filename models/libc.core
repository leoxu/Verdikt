// char *strdup(const char *s): malloc(strlen+1) and copy, NULL when the allocation fails.
core.func @strdup(ptr) -> ptr {
^entry(%s: ptr):
  %len = core.call @__hlir_strlen(%s) : i64
  %one = core.const 1 : i64
  %n = core.add %len, %one : i64
  %p = core.heap_alloc %n {fail=nondet, name="strdup_fail"} : ptr
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^out, ^copy
^copy:
  core.memcpy %p, %s, %n
  core.br ^out
^out:
  core.return %p
}

// char *strndup(const char *s, size_t n): strdup bounded by n -- copies at most n bytes and ALWAYS NUL-terminates,
// so the allocation is strnlen(s, n) + 1 and never n + 1 when the string is shorter. Left opaque it returns an
// unconstrained pointer, which cuts the taint at every place a parser keeps a copy of a field it just read:
// libssh calls it on strings taken straight off the wire (src/misc.c, src/options.c).
core.func @strndup(ptr, i64) -> ptr {
^entry(%s: ptr, %n: i64):
  %len = core.call @__hlir_strnlen(%s, %n) : i64
  %one = core.const 1 : i64
  %sz = core.add %len, %one : i64
  %p = core.heap_alloc %sz {fail=nondet, name="strndup_fail"} : ptr
  %isn = core.is_null %p : bool
  core.cond_br %isn, ^out, ^copy
^copy:
  core.memcpy %p, %s, %len
  %last = core.ptr_add %p, %len : ptr
  %nul = core.const 0 : i8
  core.store %nul, %last {waived="allocated len + 1 bytes above"}
  core.br ^out
^out:
