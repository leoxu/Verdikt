// int munmap(void *addr, size_t len): the mapping must be one returned by mmap (a live object), unmapped as a whole.
core.func @munmap(ptr, i64) -> i32 {
^entry(%p: ptr, %len: i64):
  core.check.free %p {expect=heap, origin="munmap"}
  core.free %p
  %z = core.const 0 : i32
  core.return %z
